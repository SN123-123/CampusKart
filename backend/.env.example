PORT=5000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-string

# MySQL (structured data: users, listings, categories, images, wishlist)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=siddesh1234
MYSQL_DATABASE=campuskart

# MongoDB (flexible data: chat conversations, messages, notifications)
MONGO_URI=mongodb://127.0.0.1:27017/campuskart

# =============================================================================
# Email Configuration (Nodemailer)
# =============================================================================
# Development mode: Leave SMTP_HOST empty, and OTP verification codes will be
# printed directly to the backend terminal console.
#
# Option A: Gmail (Requires 2FA + an App Password, NOT your regular account password)
#   Generate App Password: https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-account@gmail.com
#   SMTP_PASS=xxxx-xxxx-xxxx-xxxx
#   MAIL_FROM=CampusKart <your-account@gmail.com>
#
# Option B: Brevo / Sendinblue (Free 300 emails/day)
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your-brevo-login-email
#   SMTP_PASS=your-brevo-smtp-key
#   MAIL_FROM=CampusKart <verified-sender@yourdomain.com>
#
# Option C: Mailtrap (Safe email testing sandbox)
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=your-mailtrap-username
#   SMTP_PASS=your-mailtrap-password
#   MAIL_FROM=CampusKart <no-reply@campuskart.local>
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusKart <no-reply@campuskart.local>
SMTP_SECURE=false

# Used by: npm run seed:admin
ADMIN_NAME=CampusKart Admin
ADMIN_EMAIL=admin@campuskart.local
ADMIN_PASSWORD=Admin@12345











